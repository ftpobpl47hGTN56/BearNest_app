<?xml version="1.0" encoding="utf-8"?>
<!--
    [NotifButtons] Своё содержимое уведомления VPN.
    Используется и в свёрнутом, и в развёрнутом виде, поэтому кнопки
    «Отключить» / «Следующий» видны ВСЕГДА, без жеста разворачивания.
    Шапку (иконка медведя, «BearNest», время) рисует система —
    через NotificationCompat.DecoratedCustomViewStyle.
    В RemoteViews разрешены только простые View: LinearLayout, TextView, ImageView…
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Статус: «Подключено: 🇳🇱 Netherlands» -->
    <TextView
        android:id="@+id/notif_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <!-- Кнопка «Следующий сервер» -->
    <TextView
        android:id="@+id/notif_btn_next"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/notif_btn_bg"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/notif_btn_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Кнопка «Отключить» -->
    <TextView
        android:id="@+id/notif_btn_stop"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/notif_btn_stop_bg"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/notif_btn_stop_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
